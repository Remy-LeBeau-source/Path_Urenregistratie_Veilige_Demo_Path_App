Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^uren\.pathconsultancy\.nl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://uren.pathconsultancy.nl%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Alleen wat de app zelf nodig heeft, hoort via het web bereikbaar te zijn.
#
# De uitrol zet de hele repository in de webmap. Tot 18 sep 2026 stond daardoor
# alles open wat niet met een punt begint: de wensenlijst met namen en
# werkpatronen van medewerkers, de overdrachtsnotities, de testrollen, de
# omgevingsbestanden (ook die van productie), de beheerscripts in server/scripts
# en de volledige node_modules -- op TEST en op PROD. Er stonden geen werkende
# wachtwoorden in, maar dit hoort niet op internet.
#
# Wat hieronder dicht gaat, laadt de app nergens zelf; nagekeken in index.html,
# sw.js, assets/, pilot/ en server/. scripts/webtoegang-check.mjs toetst deze
# regels tegen elk bestand in de repository: wat de app nodig heeft moet open
# blijven, de rest dicht. Pas je hier iets aan, draai dan die controle.

# Documentatie, broncode van tests en scripts, databaseschema's, omgevingen.
<FilesMatch "\.(md|env|sql|feature|ts|mjs|ps1|cmd|sh|lock|log|example|pdf)$">
  Require all denied
</FilesMatch>

# Projectbestanden die niets met de draaiende app te maken hebben.
<FilesMatch "^(package(-lock)?\.json|vite\.config\.js)$">
  Require all denied
</FilesMatch>

# Hele mappen die alleen voor ontwikkeling bestaan. server/scripts valt hier ook
# onder: dat zijn beheertaken voor de opdrachtregel (reset, back-up, herstel,
# inrichting), en de meeste controleren zelf niet of ze via het web worden
# aangeroepen.
<If "%{REQUEST_URI} =~ m#(^|/)(environments|tests|scripts|node_modules|design-mockups|agents|allure-results|allure-report)/#">
  Require all denied
</If>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:"
  # Prepared only. Enable after HTTPS has been proven in production:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # De app-shell en de service worker moeten elke keer bij de server revalideren,
  # zodat een nieuwe deploy meteen zichtbaar is zonder harde refresh. De assets
  # zelf zijn ge-cachebust met ?v=<versie>, dus die mogen wel gecachet blijven.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
