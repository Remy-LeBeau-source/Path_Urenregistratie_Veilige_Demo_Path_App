{
  "name": "path-urenregistratie",
  "version": "0.9.50",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node --check assets/app.js && node scripts/smoke-test.mjs && npm run test:design && npm run test:ops",
    "test:design": "node scripts/test-design-audit.mjs",
    "test:ops": "php server/scripts/production-preflight.php --config=server/config.example.php && php server/scripts/mail-preflight.php --config=server/config.example.php && php server/scripts/database-backup.php --config=server/config.example.php && php server/scripts/database-restore.php --config=server/config.example.php --file=database/schema.sql && php server/scripts/rotate-logs.php --config=server/config.example.php && php server/scripts/configure-production.php && php server/scripts/provision-company.php --config=server/config.example.php && php server/scripts/provision-account.php --config=server/config.example.php",
    "prod:configure": "php server/scripts/configure-production.php",
    "test:closeout": "node scripts/closeout-to-zero-check.mjs",
    "test:gui-smoke": "node scripts/run-playwright-e2e.mjs --grep DASH-N-010 && node scripts/run-playwright-e2e.mjs --grep TS-REV-UI-H-008 && node scripts/run-playwright-e2e.mjs --grep DASH-N-016",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security:deps:full": "npm audit --audit-level=moderate",
    "ci:local": "npm run build && npm run check && npm run test:db:crud && npm run security:deps",
    "test:db:crud": "node scripts/run-db-crud-smoke.mjs",
    "test:db:bootstrap": "node scripts/bootstrap-playwright-db.mjs",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:dev": "set PLAYWRIGHT_STAGE=dev&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:test": "set PLAYWRIGHT_STAGE=test&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:acc": "set PLAYWRIGHT_STAGE=acc&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:prod": "set PLAYWRIGHT_STAGE=prod&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:auth": "set PLAYWRIGHT_GROUP=auth&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:security": "set PLAYWRIGHT_GROUP=security&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:dashboard": "set PLAYWRIGHT_GROUP=dashboard&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:invoices": "set PLAYWRIGHT_GROUP=invoices&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:roles": "set PLAYWRIGHT_GROUP=roles&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:timesheets": "set PLAYWRIGHT_GROUP=timesheets&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:customer": "set PLAYWRIGHT_GROUP=customer&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:api": "set PLAYWRIGHT_GROUP=api&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:ui": "set PLAYWRIGHT_GROUP=ui&& node scripts/run-playwright-e2e.mjs",
    "test:e2e:group:ui-desktop": "set PLAYWRIGHT_GROUP=ui-desktop&& node scripts/run-playwright-e2e.mjs --project=desktop-chromium",
    "test:e2e:group:ui-mobile": "set PLAYWRIGHT_GROUP=ui-mobile&& node scripts/run-playwright-e2e.mjs --project=mobile-chrome --project=mobile-safari",
    "test:e2e:mobile": "node scripts/run-playwright-e2e.mjs --project=mobile-chrome --project=mobile-safari",
    "test:e2e:mobile:headed": "node scripts/run-playwright-e2e.mjs --project=mobile-chrome --project=mobile-safari --headed",
    "test:e2e:mobile:ui": "node scripts/run-playwright-e2e.mjs --project=mobile-chrome --project=mobile-safari --ui",
    "test:e2e:headed": "node scripts/run-playwright-e2e.mjs --headed",
    "test:e2e:ui-all:headed": "set PLAYWRIGHT_GROUP=ui-desktop,ui-mobile&& node scripts/run-playwright-e2e.mjs --headed",
    "test:e2e:ui": "node scripts/run-playwright-e2e.mjs --ui",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "docs:sync": "node scripts/sync-living-docs.mjs",
    "docs:bundle": "node scripts/build-live-doc-bundle.mjs",
    "docs:refresh": "npm run docs:sync && npm run test:e2e && npm run allure:generate && npm run docs:bundle"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.3",
    "dotenv": "^16.6.1",
    "jsdom": "^26.1.0",
    "jspdf": "^4.2.1",
    "mysql2": "^3.23.2",
    "vite": "^7.1.1"
  }
}
